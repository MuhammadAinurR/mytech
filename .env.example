# Copy to .env.local and adjust. Never commit real values.

# Postgres. Only workbench_* databases are touched by scripts and tests.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workbench_dev

# Redis. DB 1 for dev; tests use DB 2. All keys are prefixed with "wb:".
REDIS_URL=redis://localhost:6379/1

# Public origin of the app, used for absolute URLs and cookie security.
APP_URL=http://localhost:3000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Credential encryption (AES-256-GCM). Comma-separated "<version>:<base64 32-byte key>".
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate: add a new version, point ENCRYPTION_KEY_VERSION at it, run `npm run keys:rotate`,
# then remove the old key once no rows use it.
ENCRYPTION_KEYS=1:<base64-encoded 32 random bytes>
ENCRYPTION_KEY_VERSION=1

# Private object storage (MinIO or another S3-compatible service) for uploaded PDFs.
# Locally: `brew services run minio`, which serves http://127.0.0.1:9000 with
# minioadmin/minioadmin. Only use buckets named workbench-* there; dev creates its bucket
# on first upload. Production uses its own bucket and a key limited to it (deploy/README.md).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=workbench-dev

# Web Push for invoice reminders (optional; all three or none). Generate a pair with
# `npx web-push generate-vapid-keys`. Keep the private key secret; changing the pair
# means every device has to turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
